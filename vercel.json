{
  "cleanUrls": true,
  "headers": [
    {
      "source": "/",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=300"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/css/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/js/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=86400"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/assets/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=31536000, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/laicaiyoufang",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    },
    {
      "source": "/laicaiyoufang/:path*",
      "headers": [
        {
          "key": "x-vercel-enable-rewrite-caching",
          "value": "1"
        },
        {
          "key": "CDN-Cache-Control",
          "value": "public, max-age=86400, stale-while-revalidate=604800"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/laicaiyoufang/",
      "destination": "/laicaiyoufang",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/laicaiyoufang",
      "destination": "https://laicaiyoufang-vercel.vercel.app/laicaiyoufang/"
    },
    {
      "source": "/laicaiyoufang/:path*",
      "destination": "https://laicaiyoufang-vercel.vercel.app/laicaiyoufang/:path*"
    }
  ]
}
